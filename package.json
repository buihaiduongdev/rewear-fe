{
  "name": "rewear-fe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 5000",
    "build": "next build",
    "start": "next start --port 5000",
    "lint": "eslint",
    "check": "tsc --noEmit && pnpm lint",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:generate": "orval",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "cypress run --browser chrome",
    "test:e2e:open": "cypress open",
    "test:e2e:typecheck": "tsc --project tests/cypress/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^5.9.1",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@types/ms": "^2.1.0",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.55.0",
    "ms": "^2.1.3",
    "next": "16.4.1",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cypress": "^16.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "orval": "^8.44.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.22.0",
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
